                                      1 ; ============================================================================
                                      2 ;  FILE       : asm_test.asm
                                      3 ;  AUTHOR     : LeoChieco
                                      4 ;  DATE       : 01 March 2026
                                      5 ;  VERSION    : 1.0
                                      6 ;  PROJECT    : ZEOS
                                      7 ;  DESCRIPTION: toolchain SDCC 
                                      8 ;				How to write a piece of code in assembler and locate it in a 
                                      9 ;				specific memory address. 	
                                     10 ; ============================================================================
                                     11 
                                     12 .module asm_test
                                     13 .globl _serial_putc
                                     14 
                                     15 .area _STUB (ABS)
      001800                         16 .org 0x1800
                                     17 
      001800                         18 start:
                                     19 
      001800 F5               [11]   20 	push af        
      001801 E5               [11]   21 	push hl        
                                     22 
      001802 21 15 18         [10]   23     ld hl,#msg
                                     24 
      001805                         25 loop:
      001805 7E               [ 7]   26     ld a,(hl)
      001806 B7               [ 4]   27     or a
      001807 28 09            [12]   28     jr z,done
                                     29 
      001809 E5               [11]   30     push hl        ; salva puntatore stringa
      00180A 6F               [ 4]   31     ld l,a         ; parametro in L (SDCC ABI)
      00180B CD 00 00         [17]   32     call _serial_putc
      00180E E1               [10]   33     pop hl         ; ripristina HL
                                     34 
      00180F 23               [ 6]   35     inc hl
      001810 18 F3            [12]   36     jr loop
                                     37 
      001812                         38 done:
      001812 E1               [10]   39 	pop hl          
      001813 F1               [10]   40 	pop af          
      001814 C9               [10]   41     ret
                                     42 
      001815                         43 msg:
      001815 48 45 4C 4C 4F 20 46    44     .ascii "HELLO FROM 1800h\r\n"
             52 4F 4D 20 31 38 30
             30 68 0D 0A
      001827 00                      45     .db 0
